<!-- Bootstrap 5 JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Menampilkan tahun secara otomatis
    document.getElementById("tahun").textContent =
        new Date().getFullYear();


    // Menampilkan detail proyek dalam modal
    const modalProyek = document.getElementById("modalProyek");

    modalProyek.addEventListener("show.bs.modal", function(event) {

        const tombol = event.relatedTarget;

        const nama = tombol.getAttribute("data-nama");
        const detail = tombol.getAttribute("data-detail");

        document.getElementById("namaProyek").textContent = nama;
        document.getElementById("detailProyek").textContent = detail;

    });


    // Validasi formulir kontak
    const formKontak = document.getElementById("formKontak");
    const feedback = document.getElementById("feedback");

    formKontak.addEventListener("submit", function(event) {

        event.preventDefault();

        if (!formKontak.checkValidity()) {

            formKontak.classList.add("was-validated");

            feedback.innerHTML =
                '<div class="alert alert-danger">Periksa kembali data yang kamu isi.</div>';

            return;

        }

        feedback.innerHTML =
            '<div class="alert alert-success">Form berhasil divalidasi! (Demo, belum dikirim ke server.)</div>';

        formKontak.reset();

        formKontak.classList.remove("was-validated");

    });


const modalSertifikat = document.getElementById("modalSertifikat");

modalSertifikat.addEventListener("show.bs.modal", function(event) {

    const tombol = event.relatedTarget;

    const judul = tombol.getAttribute("data-judul");
    const gambar = tombol.getAttribute("data-gambar");

    document.getElementById("judulSertifikat").textContent = judul;

    document.getElementById("gambarSertifikat").src = gambar;

});

</script>

