        #e4f2ff,
        #f5e6ff,
        #ffe8f5,
        #e1ffff
    );
    background-size: 300% 300%;
    animation: hologramBg 10s ease infinite;
}

/* Animasi background */
@keyframes hologramBg {
    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}

